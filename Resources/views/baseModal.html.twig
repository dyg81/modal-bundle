{% set modalId = block('modalId')|trim|default('base-modal') %}
{% set modalTitleContent = block('modalTitle')|trim %}
{% set modalHeaderContent = block('modalHeader')|trim %}
{% set modalLocale = app.request ? app.request.locale : 'en' %}
{% set modalLang = modalLocale|replace({'_': '-'}) %}
{% set modalLanguage = modalLang|split('-')|first|lower %}
{% set modalDir = modalLanguage in ['ar', 'he'] ? 'rtl' : 'ltr' %}
<div id="{% block modalId %}base-modal{% endblock %}" class="modal {% block modalEffects %}fade{% endblock %}" {% block modalBackdrop %}{% endblock %} role="dialog" tabindex="-1" aria-modal="true" lang="{{ modalLang }}" dir="{{ modalDir }}"{% if modalTitleContent %} aria-labelledby="{{ modalId }}-title"{% else %} aria-label="{{ 'modal.dialog.label'|trans({}, 'Dyg81ModalBundle') }}"{% endif %}>
  <div class="modal-dialog {% block modalSize %}{% endblock %}">
    <div class="modal-content">
        {% block modalContent %}
            {% if modalTitleContent or modalHeaderContent %}
                <div class="modal-header">
                    {% if modalTitleContent %}
                        <h5 class="modal-title" id="{{ modalId }}-title">{% block modalTitle %}{% endblock %}</h5>
                    {% endif %}
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'modal.button.close'|trans({}, 'Dyg81ModalBundle') }}"></button>
                    {% if modalHeaderContent %}
                        {% block modalHeader %}{% endblock %}
                    {% endif %}
                </div>
            {% endif %}
            <div class="modal-body">
              {% block modalBody %}{% endblock %}
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'modal.button.close'|trans({}, 'Dyg81ModalBundle') }}</button>
              {% block modalFooter %}{% endblock %}
            </div>
        {% endblock %}
    </div>
  </div>
</div>
