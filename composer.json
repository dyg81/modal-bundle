{
    "name": "dyg81/modal-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle that lets you open Bootstrap modals easily.",
    "keywords": ["symfony", "bundle", "bootstrap", "modal", "ajax"],
    "homepage": "https://github.com/dyg81/modal-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Donald Yañez González",
            "email": "donald.yanez@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Rares Serban",
            "email": "raresserban96@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "symfony/framework-bundle": "^4.4||^5.3",
        "sensio/framework-extra-bundle": "^5.1||^6.1",
        "symfony/translation": "^4.4||^5.3",
        "twig/extra-bundle": "^3.0"
    },
    "require-dev": {
        "symfony/asset": "^3.4 || ^4.4 || ^5.4 || ^6.0",
        "symfony/browser-kit": "^3.4 || ^4.4 || ^5.4 || ^6.0",
        "symfony/console": "^3.4 || ^4.4 || ^5.4 || ^6.0",
        "symfony/css-selector": "^3.4 || ^4.4 || ^5.4 || ^6.0",
        "symfony/flex": "^1.18 || ^2.0",
        "symfony/phpunit-bridge": "^5.4 || ^6.0",
        "symfony/twig-bundle": "^3.4 || ^4.4 || ^5.4 || ^6.0",
        "symfony/yaml": "^3.4 || ^4.4 || ^5.4 || ^6.0",
        "phpunit/phpunit": "^7.5 || ^8.5 || ^9.5"
    },
    "autoload": {
        "psr-4": {"Dyg81\\ModalBundle\\": "src"}
    },
    "autoload-dev": {
        "psr-4": {"Dyg81\\ModalBundle\\Tests\\": "tests"}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint:php": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "lint": ["composer validate --strict", "@lint:php"],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
