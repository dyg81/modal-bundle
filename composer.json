{
    "name": "dyg81/modal-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle to open Bootstrap 5 modals (content, forms and confirmations) with native JavaScript, without jQuery.",
    "keywords": ["symfony", "bundle", "bootstrap", "bootstrap5", "modal", "ajax"],
    "homepage": "https://github.com/dyg81/modal-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Donald Yañez González",
            "email": "donald.yanez@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Rares Serban",
            "email": "raresserban96@gmail.com",
            "role": "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/dyg81/modal-bundle/issues",
        "source": "https://github.com/dyg81/modal-bundle"
    },
    "require": {
        "php": ">=8.1",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/framework-bundle": "^6.4 || ^7.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/routing": "^6.4 || ^7.4",
        "symfony/translation": "^6.4 || ^7.4",
        "symfony/twig-bundle": "^6.4 || ^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/css-selector": "^6.4 || ^7.4",
        "symfony/yaml": "^6.4 || ^7.4"
    },
    "autoload": {
        "psr-4": { "Dyg81\\ModalBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Dyg81\\ModalBundle\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}