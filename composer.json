{
    "name": "dyg81/modal-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle that lets you open Bootstrap modals easily.",
    "keywords": ["symfony", "bundle", "bootstrap", "modal", "ajax"],
    "homepage": "https://github.com/dyg81/modal-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Donald Yañez González",
            "email": "donald.yanez@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Rares Serban",
            "email": "raresserban96@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/yaml": "^8.1",
        "twig/twig": "^3.25"
    },
    "require-dev": {
        "symfony/asset": "^8.1",
        "symfony/browser-kit": "^8.1",
        "symfony/console": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/flex": "^2.5",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {"Dyg81\\ModalBundle\\": "src"}
    },
    "autoload-dev": {
        "psr-4": {"Dyg81\\ModalBundle\\Tests\\": "tests"}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint:php": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "lint": ["composer validate --strict", "@lint:php"]
    }
}
